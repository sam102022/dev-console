{% extends 'base.html.twig' %}

{% block body %}
<style>
.sortable-header {
    cursor: pointer;
    text-decoration: none;
    color: inherit;
}
.sortable-header:hover {
    text-decoration: underline;
}
.sort-icon {
    font-size: 0.8em;
    margin-left: 5px;
    opacity: 0.5;
}
.log-link {
    opacity: 0.6;
    transition: opacity 0.2s;
}
.log-link:hover {
    opacity: 1;
}
.url-link {
    opacity: 0.6;
    transition: opacity 0.2s;
}
.url-link:hover {
    opacity: 1;
}
</style>
<div class="card shadow rounded mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">🩺 Monitoring &amp; 🔗 Links</h5>
        <div>
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm" type="button" id="columns-dropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa-solid fa-table-columns"></i> Colonnes
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="columns-dropdown" id="columns-menu">
                    <h6 class="dropdown-header">Afficher/Masquer les colonnes</h6>
                    <div class="px-3 py-2">
                        <div class="form-check">
                            <input class="form-check-input column-toggle" type="checkbox" id="toggle-col-domain" data-column="domain" checked>
                            <label class="form-check-label" for="toggle-col-domain">Domaine</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input column-toggle" type="checkbox" id="toggle-col-sf" data-column="sf" checked>
                            <label class="form-check-label" for="toggle-col-sf">SF</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input column-toggle" type="checkbox" id="toggle-col-techno" data-column="techno" checked>
                            <label class="form-check-label" for="toggle-col-techno">Techno</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input column-toggle" type="checkbox" id="toggle-col-archived" data-column="archived" checked>
                            <label class="form-check-label" for="toggle-col-archived">Archivé</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input column-toggle" type="checkbox" id="toggle-col-gcp" data-column="gcp" checked>
                            <label class="form-check-label" for="toggle-col-gcp">GCP</label>
                        </div>
                        <div class="dropdown-divider"></div>
                        <div class="form-check">
                            <input class="form-check-input column-toggle" type="checkbox" id="toggle-col-dev" data-column="dev" checked>
                            <label class="form-check-label" for="toggle-col-dev">DEV</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input column-toggle" type="checkbox" id="toggle-col-rec" data-column="rec" checked>
                            <label class="form-check-label" for="toggle-col-rec">REC</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input column-toggle" type="checkbox" id="toggle-col-pp" data-column="pp" checked>
                            <label class="form-check-label" for="toggle-col-pp">PP</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input column-toggle" type="checkbox" id="toggle-col-prod" data-column="prod" checked>
                            <label class="form-check-label" for="toggle-col-prod">PROD</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 text-nowrap" id="projects-table">
                <thead class="thead-dark">
                    <tr>
                        <th class="text-center" style="width: 30px;">
                            <input type="checkbox" id="check-all" title="Tout cocher/décocher">
                        </th>
                        <th style="width: 50px;">#</th>
                        <th data-column="domain"><a class="sortable-header" data-sort="domain">Domaine <i class="fa-solid fa-sort sort-icon"></i></a></th>
                        <th data-column="sf"><a class="sortable-header" data-sort="sf">SF <i class="fa-solid fa-sort sort-icon"></i></a></th>
                        <th><a class="sortable-header" data-sort="name">Nom <i class="fa-solid fa-sort sort-icon"></i></a></th>
                        <th data-column="techno"><a class="sortable-header" data-sort="techno">Techno <i class="fa-solid fa-sort sort-icon"></i></a></th>
                        <th data-column="archived"><a class="sortable-header" data-sort="archived">Archivé <i class="fa-solid fa-sort sort-icon"></i></a></th>
                        <th data-column="gcp"><a class="sortable-header" data-sort="gcp">GCP <i class="fa-solid fa-sort sort-icon"></i></a></th>
                        <th class="text-center" style="width: 120px;" data-column="dev">
                            <div class="d-flex justify-content-center align-items-center">
                                <span>DEV</span>
                                <span class="ml-2" style="cursor: pointer;" data-toggle="collapse" data-target="#legend-row" aria-expanded="false" aria-controls="legend-row">
                                    <i class="fa-solid fa-circle-info text-muted" data-toggle="tooltip" data-placement="top" title="Afficher/Masquer la légende"></i>
                                </span>
                            </div>
                        </th>
                        <th class="text-center" style="width: 120px;" data-column="rec">REC</th>
                        <th class="text-center" style="width: 120px;" data-column="pp">PP</th>
                        <th class="text-center" style="width: 120px;" data-column="prod">PROD</th>
                        <th class="text-center" style="width: 80px;">Actions</th>
                    </tr>
                    <tr>
                        <td colspan="13" class="p-0" style="border: none;">
                            <div class="collapse" id="legend-row">
                                <div class="card card-body bg-light border-0">
                                    <small class="text-muted">
                                        <i class="fa-brands fa-gitlab text-warning"></i> Projet Gitlab |
                                        <i class="fa-solid fa-box-archive text-danger"></i> Projet archivé |
                                        <i class="fa-brands fa-google text-primary"></i> Projet sur GCP |
                                        <i class="fa-solid fa-hourglass"></i> Health Check |
                                        <i class="fa-solid fa-tag"></i> Version |
                                        <i class="fa-solid fa-desktop text-success"></i> Front |
                                        <i class="fa-solid fa-comment-dots text-primary"></i> Pub/Sub |
                                        <i class="fa-solid fa-file-lines text-info"></i> Logs |
                                        <i class="fa-solid fa-code-branch text-danger"></i> Rundeck |
                                        <i class="fa-solid fa-server text-secondary"></i> Déploiement |
                                        <i class="fa-solid fa-chart-line text-info"></i> New Relic
                                    </small>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th></th>
                        <th></th>
                        <th data-column="domain">
                            <div class="input-group input-group-sm">
                                <select id="filter_domain" class="form-control custom-select filter-input">
                                    <option value="all">Tous</option>
                                    {% for key, value in domains %}
                                        <option value="{{ key }}">{{ value }}</option>
                                    {% endfor %}
                                </select>
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('filter_domain').value='all'; document.getElementById('filter_domain').dispatchEvent(new Event('change'));" title="Effacer"><i class="fa-solid fa-xmark"></i></button>
                                </div>
                            </div>
                        </th>
                        <th data-column="sf">
                            <div class="input-group input-group-sm">
                                <select id="filter_sf" class="form-control custom-select filter-input">
                                    <option value="all">Tous</option>
                                    {% for key, value in sfs %}
                                        <option value="{{ key }}">{{ value }}</option>
                                    {% endfor %}
                                </select>
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('filter_sf').value='all'; document.getElementById('filter_sf').dispatchEvent(new Event('change'));" title="Effacer"><i class="fa-solid fa-xmark"></i></button>
                                </div>
                            </div>
                        </th>
                        <th>
                            <div class="input-group input-group-sm">
                                <input type="text" id="filter_project_name" class="form-control filter-input" placeholder="Filtrer par nom..." aria-label="Filtrer par nom">
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('filter_project_name').value=''; document.getElementById('filter_project_name').dispatchEvent(new Event('input'));" title="Effacer"><i class="fa-solid fa-xmark"></i></button>
                                </div>
                            </div>
                        </th>
                        <th data-column="techno">
                            <div class="input-group input-group-sm">
                                <select id="filter_techno" class="form-control custom-select filter-input">
                                    <option value="all">Toutes</option>
                                    {% if technos is defined %}
                                        {% for key, value in technos %}
                                            <option value="{{ key }}">{{ value }}</option>
                                        {% endfor %}
                                    {% endif %}
                                </select>
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('filter_techno').value='all'; document.getElementById('filter_techno').dispatchEvent(new Event('change'));" title="Effacer"><i class="fa-solid fa-xmark"></i></button>
                                </div>
                            </div>
                        </th>
                        <th data-column="archived">
                            <div class="input-group input-group-sm">
                                <select id="filter_archived" class="form-control custom-select filter-input">
                                    <option value="all">Tous</option>
                                    <option value="non" selected>Non</option>
                                    <option value="oui">Oui</option>
                                </select>
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('filter_archived').value='all'; document.getElementById('filter_archived').dispatchEvent(new Event('change'));" title="Effacer"><i class="fa-solid fa-xmark"></i></button>
                                </div>
                            </div>
                        </th>
                        <th data-column="gcp">
                            <div class="input-group input-group-sm">
                                <select id="filter_gcp" class="form-control custom-select filter-input">
                                    <option value="all">Tous</option>
                                    <option value="non">Non</option>
                                    <option value="oui">Oui</option>
                                </select>
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('filter_gcp').value='all'; document.getElementById('filter_gcp').dispatchEvent(new Event('change'));" title="Effacer"><i class="fa-solid fa-xmark"></i></button>
                                </div>
                            </div>
                        </th>
                        <th data-column="dev">
                        </th>
                        <th data-column="rec">
                        </th>
                        <th data-column="pp">
                        </th>
                        <th data-column="prod">
                        </th>
                        <th>
                            <button class="btn btn-outline-light btn-sm mr-2" type="button" id="btn-reset-filters" title="Réinitialiser les filtres"><i class="fa-solid fa-rotate-left"></i></button>
                            <button id="btn-check-selected" class="btn btn-outline-primary btn-sm mr-2" onclick="checkHealth('selected')" title="Vérifier cochés"><i class="fa-solid fa-rotate"></i></button>
                            <button id="btn-stop-health" class="btn btn-danger btn-sm d-none" onclick="stopHealthCheck()" title="Arrêter"><i class="fa-solid fa-stop"></i> Arrêter</button>
                        </th>
                    </tr>
                </thead>
                <tbody id="projects-tbody">
                    {% for r in results %}
                        {% set isEligibleForActuatorInfo = r.name starts with 'api' or r.name starts with 'flow' and r.techno == 'java' %}
                        {% set isEligibleForHealth = r.name starts with 'api' or r.name starts with 'flow' and r.techno == 'java' %}
                        {% set isEligibleForLogs = r.techno is defined and r.techno != '' and r.techno != 'php' %}
                        <tr class="project-row" data-project-name="{{ r.name }}">
                            <td class="text-center">
                                <input type="checkbox" class="row-checkbox">
                            </td>
                            <td class="col-index text-muted font-weight-bold"></td>
                            <td class="col-domain" data-column="domain" data-value="{{ r.domain }}">{{ r.domain }}</td>
                            <td class="col-sf" data-column="sf" data-value="{{ r.sf }}">{{ r.sf }}</td>
                            <td class="col-name">
                                {% set projectName = r.name|length > 35
                                    ? r.name|slice(0, 35) ~ '...'
                                    : r.name
                                %}
                                {% if r.webUrl is defined and r.webUrl != '' %}
                                    <a href="{{ r.webUrl }}"
                                       class="url-link text-decoration-none"
                                       target="_blank"
                                       title="Voir le projet Gitlab{% if r.archived %} archivé{% endif %} {{ r.name }}">
                                        <i class="fa-brands fa-gitlab text-warning"></i> {{ projectName }}
                                    </a>
                                {% else %}
                                    {{ projectName }}
                                {% endif %}
                            </td>
                            <td class="col-techno" data-column="techno" data-value="{{ r.techno|default('') }}">
                                {% if r.techno is defined and r.techno %}
                                    {{ r.techno }}
                                {% endif %}
                            </td>
                            <td class="col-archived" data-column="archived" data-value="{% if r.archived %}oui{% else %}non{% endif %}">
                                {% if r.archived %}<i class="fa-solid fa-box-archive text-danger mr-1" title="Projet archivé"></i>{% endif %}
                            </td>
                            <td class="col-gcp" data-column="gcp" data-value="{% if r.cloudGCP == 1 %}oui{% else %}non{% endif %}">
                                {% if r.cloudGCP == 1 %}<i class="fa-brands fa-google text-primary"></i>{% else %}-{% endif %}
                            </td>

                            {% for env in ['dev', 'rec', 'pp', 'prod'] %}
                            <td class="col-{{ env }} text-left" data-column="{{ env }}" data-env="{{ env }}"
                                data-url-actuator-info="{% if isEligibleForActuatorInfo %}{{ r.urlActuatorInfo[env] | default('') }}{% endif %}"
                                data-url-health="{% if isEligibleForHealth %}{{ r.urlHealthCheck[env] | default('') }}{% endif %}"
                                data-url-logs="{{ r.urlLogs[env] | default('') }}">

                                {% if isEligibleForHealth %}
                                    <span class="health-badge badge badge-secondary"><i class="fa-solid fa-hourglass"></i></span>
                                {% endif %}
                                {% if isEligibleForActuatorInfo %}
                                    <span class="version-badge badge badge-secondary ml-1"><i class="fa-solid fa-tag"></i></span>
                                {% endif %}

                                {% if (r.techno == 'react' or r.techno == 'nuxt' or r.techno == 'php') and r.urlFronts[env] is defined and r.urlFronts[env] != '' %}
                                    <a href="{{ r.urlFronts[env] }}" class="url-link ml-2" target="_blank" title="Voir le front de {{ env }}">
                                        <i class="fa-solid fa-desktop text-success"></i>
                                    </a>
                                {% endif %}

                                {% if r.urlPubsubs[env] is defined and r.urlPubsubs[env] != '' %}
                                    <a href="{{ r.urlPubsubs[env] }}" class="url-link ml-2" target="_blank" title="Voir le pubsub de {{ env }}">
                                        <i class="fa-solid fa-comment-dots text-primary"></i>
                                    </a>
                                {% endif %}

                                {% if isEligibleForLogs and r.urlLogs[env] is defined and r.urlLogs[env] != '' %}
                                <a href="{{ r.urlLogs[env] }}" class="log-link ml-2" target="_blank" title="Voir les logs de {{ env }}">
                                    <i class="fa-solid fa-file-lines text-info"></i>
                                </a>
                                {% endif %}

                                {% if r.urlsRundeck[env] is defined and r.urlsRundeck[env] != '' %}
                                <a href="{{ r.urlsRundeck[env] }}" class="url-link ml-2" target="_blank" title="Voir le Rundeck de {{ env }}">
                                    <i class="fa-solid fa-code-branch text-danger"></i>
                                </a>
                                {% endif %}

                                {% if r.urlsDeploymentGcp[env] is defined and r.urlsDeploymentGcp[env] != '' %}
                                <a href="{{ r.urlsDeploymentGcp[env] }}" class="url-link ml-2" target="_blank" title="Voir le déploiement de {{ env }}">
                                    <i class="fa-solid fa-server text-secondary"></i>
                                </a>
                                {% endif %}

                                {% if r.techno == 'java' and (env == 'rec' or env == 'prod') %}
                                <a href="#" class="new-relic-link ml-2" data-project="{{ r.name }}" data-env="{{ env }}" title="Voir sur New Relic ({{ env }})">
                                    <i class="fa-solid fa-chart-line text-info"></i>
                                </a>
                                {% endif %}
                            </td>
                            {% endfor %}

                            <td class="text-center">
                                {% if isEligibleForHealth %}
                                    <button class="btn btn-sm btn-outline-primary btn-check-single" onclick="checkSingleRow(this)"><i class="fa-solid fa-rotate"></i></button>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center">
        <div>
            <select id="rows_per_page" class="form-control form-control-sm d-inline-block w-auto">
                <option value="10">10 par page</option>
                <option value="15" selected>15 par page</option>
                <option value="25">25 par page</option>
                <option value="50">50 par page</option>
                <option value="1000">Tout afficher</option>
            </select>
            <span id="pagination-info" class="ml-2 text-muted small"></span>
        </div>
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0" id="pagination-container">
                <!-- Les boutons de pagination seront générés ici par JS -->
            </ul>
        </nav>
    </div>
</div>

<script src="js/datagrid.js"></script>
<script>
function checkSingleRow(btn) {
    const row = btn.closest('.project-row');
    checkHealth('single', row);
}

// Function to get currently visible environment columns
function getVisibleEnvironments() {
    const visibleEnvs = [];
    ['dev', 'rec', 'pp', 'prod'].forEach(env => {
        const toggle = document.getElementById(`toggle-col-${env}`);
        if (toggle && toggle.checked) {
            visibleEnvs.push(env);
        }
    });
    return visibleEnvs;
}

// --- LOGIQUE DE MONITORING ---
let abortController = null;

async function checkHealth(mode, specificRow = null) {
    const btnCheckSelected = document.getElementById('btn-check-selected');
    const btnStop = document.getElementById('btn-stop-health');
    const singleButtons = document.querySelectorAll('.btn-check-single');

    let targetRows = [];
    if (mode === 'single') {
        targetRows = [specificRow];
    } else if (mode === 'selected') {
        targetRows = Array.from(document.querySelectorAll('.row-checkbox:checked')).map(cb => cb.closest('.project-row'));
    }

    if (targetRows.length === 0 && mode === 'selected') {
        alert("Aucune ligne cochée.");
        return;
    }

    btnCheckSelected.classList.add('d-none');
    btnStop.classList.remove('d-none');
    singleButtons.forEach(btn => btn.disabled = true);

    abortController = new AbortController();
    const signal = abortController.signal;
    const environmentsToProcess = getVisibleEnvironments(); // Get visible environments

    targetRows.forEach(row => {
        environmentsToProcess.forEach(env => { // Use visible environments
            const cell = row.querySelector(`.col-${env}`);
            if(cell) {
                const urlHealthCheck = cell.getAttribute('data-url-health');
                const urlActuatorInfo = cell.getAttribute('data-url-actuator-info');

                if (urlHealthCheck && urlHealthCheck !== '') {
                    const badge = cell.querySelector('.health-badge');
                    if (badge) {
                        badge.className = 'health-badge badge badge-warning';
                        badge.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                    }
                }
                if (urlActuatorInfo && urlActuatorInfo !== '') {
                    const badge = cell.querySelector('.version-badge');
                    if (badge) {
                        badge.className = 'version-badge badge badge-warning';
                        badge.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                    }
                }
            }
        });
    });

    try {
        // Traitement des lignes
        for (const row of targetRows) {
            if (signal.aborted) break;

            const projectName = row.getAttribute('data-project-name');
            if (!projectName) {
                updateRowBadgesError(row, environmentsToProcess); // Use visible environments
                continue;
            }

            // On lance les requêtes d'environnement pour ce projet via notre backend
            await Promise.all(
                environmentsToProcess.map(env => checkEnvironment(row, projectName, env, signal)) // Use visible environments
            );
        }
    } catch (error) {
        if (error.name !== 'AbortError') console.error("Erreur inattendue:", error);
    } finally {
        btnCheckSelected.classList.remove('d-none');
        btnStop.classList.add('d-none');
        singleButtons.forEach(btn => btn.disabled = false);

        // S'il y a eu annulation, on remet les badges "En attente" sur ceux qui tournaient encore
        if (signal.aborted) {
            resetPendingBadges(targetRows, environmentsToProcess); // Use visible environments
        }
        abortController = null;
    }
}

function stopHealthCheck() {
    if (abortController) {
        abortController.abort(); // Cela déclenche l'exception AbortError dans les fetch en cours
    }
}

async function checkEnvironment(row, projectName, env, signal) {
    const cell = row.querySelector(`.col-${env}`);
    if(!cell) return;

    const urlHealthCheck = cell.getAttribute('data-url-health');
    const urlActuatorInfo = cell.getAttribute('data-url-actuator-info');
    const healthBadge = cell.querySelector('.health-badge');
    const versionBadge = cell.querySelector('.version-badge');

    if ((!urlHealthCheck || urlHealthCheck === '') && (!urlActuatorInfo || urlActuatorInfo === '')) {
        if (healthBadge) updateBadge(healthBadge, 'N/A', 'secondary', '#');
        if (versionBadge) updateVersionBadge(versionBadge, 'N/A', 'secondary', '#');
        return;
    }

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 20000); // 10s timeout
    const combinedSignal = anySignal([signal, controller.signal]);

    try {
        const actionUrl = `?action=getMonitoringData&project=${encodeURIComponent(projectName)}&env=${encodeURIComponent(env)}`;
        const response = await fetch(actionUrl, { signal: combinedSignal });
        clearTimeout(timeoutId);
        const data = await response.json();

        if (data.success) {
            if (healthBadge) {
                if (data.health.status === 'UP') {
                    updateBadge(healthBadge, '<i class="fa-solid fa-check"></i>', 'success', data.urls.healthCheckUrl);
                } else {
                    updateBadge(healthBadge, '<i class="fa-regular fa-thumbs-down"></i>', 'danger', data.urls.healthCheckUrl);
                }
            }
            if (versionBadge) {
                updateVersionBadge(versionBadge, data.actuatorInfo.version, 'info', data.urls.actuatorInfoUrl);
            }
        } else {
            if (healthBadge) updateBadge(healthBadge, 'ERR', 'danger', urlHealthCheck);
            if (versionBadge) updateVersionBadge(versionBadge, 'ERR', 'danger', urlActuatorInfo);
        }

    } catch (error) {
        clearTimeout(timeoutId);
        if (error.name === 'AbortError') {
            if (controller.signal.aborted) { // Timeout
                if (healthBadge) updateBadge(healthBadge, 'T/O', 'warning', urlHealthCheck);
                if (versionBadge) updateVersionBadge(versionBadge, 'T/O', 'warning', urlActuatorInfo);
            } else { // User aborted
                throw error;
            }
        } else {
            if (healthBadge) updateBadge(healthBadge, 'ERR', 'danger', urlHealthCheck);
            if (versionBadge) updateVersionBadge(versionBadge, 'ERR', 'danger', urlActuatorInfo);
        }
    }
}

function anySignal(signals) {
    const controller = new AbortController();
    for (const signal of signals) {
        if (signal.aborted) {
            controller.abort();
            return controller.signal;
        }
        signal.addEventListener('abort', () => controller.abort(), { once: true });
    }
    return controller.signal;
}

function updateBadge(badge, text, type, url) {
    if (badge) {
        badge.className = `health-badge badge badge-${type}`;
        badge.innerHTML = `<a href="${url}" target="_blank" class="text-white text-decoration-none" title="${url}">${text}</a>`;
    }
}

function updateVersionBadge(badge, text, type, url) {
    if (badge) {
        badge.className = `version-badge badge badge-${type}`;
        badge.innerHTML = `<a href="${url}" target="_blank" class="text-white text-decoration-none" title="${url}">${text}</a>`;
    }
}

function updateRowBadgesError(row, environmentsToProcess) { // Renamed parameter
    environmentsToProcess.forEach(env => { // Use environmentsToProcess
        const cell = row.querySelector(`.col-${env}`);
        if(cell){
            const urlHealthCheck = cell.getAttribute('data-url-health');
            const urlActuatorInfo = cell.getAttribute('data-url-actuator-info');
            const healthBadge = cell.querySelector('.health-badge');
            const versionBadge = cell.querySelector('.version-badge');
            if (healthBadge) updateBadge(healthBadge, 'N/A', 'secondary', urlHealthCheck || '#');
            if (versionBadge) updateVersionBadge(versionBadge, 'N/A', 'secondary', urlActuatorInfo || '#');
        }
    });
}

function resetPendingBadges(rows, environmentsToProcess) { // Renamed parameter
    rows.forEach(row => {
        environmentsToProcess.forEach(env => { // Use environmentsToProcess
            const cell = row.querySelector(`.col-${env}`);
            if(cell) {
                const healthBadge = cell.querySelector('.health-badge');
                const versionBadge = cell.querySelector('.version-badge');
                if (healthBadge && healthBadge.innerHTML.includes('spinner-border')) {
                    healthBadge.className = 'health-badge badge badge-secondary';
                    healthBadge.innerHTML = '<i class="fa-solid fa-ban"></i>';
                }
                if (versionBadge && versionBadge.innerHTML.includes('spinner-border')) {
                    versionBadge.className = 'version-badge badge badge-secondary';
                    versionBadge.innerHTML = '<i class="fa-solid fa-ban"></i>';
                }
            }
        });
    });
}

// --- LOGIQUE NEW RELIC ---
document.querySelectorAll('.new-relic-link').forEach(link => {
    link.addEventListener('click', async function(e) {
        e.preventDefault();
        const project = this.getAttribute('data-project');
        const env = this.getAttribute('data-env');
        const icon = this.querySelector('i');

        console.log("icon:", icon);

        // Afficher un spinner
        if (icon) {
            icon.className = 'fa-solid fa-spinner fa-spin';
        }

        try {
            const response = await fetch(`?action=get_new_relic_url&project=${project}&env=${env}`);
            const data = await response.json();

            if (data.url) {
                window.open(data.url, '_blank');
            } else {
                alert('Erreur: Impossible de récupérer l\'URL New Relic.');
            }
        } catch (error) {
            console.error('Erreur lors de la récupération de l\'URL New Relic:', error);
            alert('Une erreur est survenue.');
        } finally {
            // Rétablir l'icône initiale
            if (icon) {
                icon.className = 'fa-solid fa-chart-line text-info';
            }
        }
    });
});
</script>
{% endblock body %}
