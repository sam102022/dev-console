<!DOCTYPE html>
<html>
<head>
    <title>Dev console</title>

    <link rel="stylesheet"
          href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

    <link rel="icon"
          type="image/png"
          href="images/favicon.png"
          id="favicon"
          data-original-href="images/favicon.png" />
    
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        [x-cloak] {
            display: none !important;
        }

        .navbar-brand {
            font-weight: bold;
        }

        .nav-link.active {
            font-weight: bold;
            text-decoration: underline;
        }

        .status {
            font-weight: bold;
            padding: 3px 6px;
            border-radius: 4px;
            color: white;
        }

        .UP {
            background: #28a745;
        }

        .DOWN {
            background: #dc3545;
        }

        .CHECKING {
            background: #ffc107;
            color: black;
        }
    </style>

</head>

<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">

        <a class="navbar-brand" href="?page=index">
            Dev tools
        </a>

        {% if session.user_id is defined and session.user_id %}

            <button class="navbar-toggler"
                    type="button"
                    data-toggle="collapse"
                    data-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav mr-auto">

                    <li class="nav-item">
                        <a class="nav-link {% if current_route is defined and current_route == constant('App\\controller\\PostmanController::ROUTE_POSTMAN') %}active{% endif %}"
                           href="?page=postman">
                            Postman Tools
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {% if current_route is defined and current_route == constant('App\\controller\\IndexController::ROUTE_INDEX') %}active{% endif %}"
                           href="?page=index">
                            Projets GitLab
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {% if current_route is defined and current_route == constant('App\\controller\\MonitoringController::ROUTE_MONITORING') %}active{% endif %}"
                           href="?page=monitoring">
                            Monitoring &amp; Liens
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link {% if current_route is defined and current_route == constant('App\\controller\\RundeckController::ROUTE_RUNDECK') %}active{% endif %}"
                           href="?page={{ constant('App\\controller\\RundeckController::ROUTE_RUNDECK') }}">
                            Rundeck
                        </a>
                    </li>

                    {% if session.user_role == 'ROLE_ADMIN' %}
                        <li class="nav-item">
                            <a class="nav-link {% if current_route is defined and current_route == constant('App\\controller\\UserAdminController::ROUTE_USERS') %}active{% endif %}"
                               href="?page=users">
                                <i class="fas fa-users-cog mr-1"></i>
                                Utilisateurs
                            </a>
                        </li>
                    {% endif %}

                </ul>

                <span class="navbar-text text-light mr-3 small">
                    <i class="fas fa-user mr-1"></i>
                    {{ session.user_email }}

                    <span class="badge
                        {% if session.user_role == 'ROLE_ADMIN' %}
                            badge-danger
                        {% else %}
                            badge-primary
                        {% endif %}
                        ml-1">

                        {% if session.user_role == 'ROLE_ADMIN' %}
                            Admin
                        {% else %}
                            User
                        {% endif %}

                    </span>
                </span>

                <a href="?page=logout"
                   class="btn btn-outline-light btn-sm">

                    <i class="fas fa-sign-out-alt mr-1"></i>
                    Déconnexion

                </a>

            </div>
        {% endif %}

    </div>
</nav>

<div class="container-fluid">
    {% block body %}
    {% endblock %}
</div>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://kit.fontawesome.com/940870b52f.js" crossorigin="anonymous"></script>

</body>
</html>