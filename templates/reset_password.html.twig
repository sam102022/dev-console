{% extends 'base.html.twig' %}

{% block body %}
<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary text-white text-center py-4">
                <h4 class="m-0"><i class="fas fa-lock mr-2"></i>Réinitialisation</h4>
                <small>Saisissez votre nouveau mot de passe</small>
            </div>
            <div class="card-body p-4">
                {% if error is defined and error %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle mr-2"></i>{{ error }}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                {% endif %}

                {% if success is defined and success %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle mr-2"></i>{{ success }}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                {% endif %}

                {% if token is defined and token %}
                <form action="?page=resetPassword&action=resetPasswordSubmit" method="POST">
                    <input type="hidden" name="token" value="{{ token }}">

                    <div class="form-group">
                        <label for="password" class="font-weight-bold">Nouveau mot de passe</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                            </div>
                            <input type="password" class="form-control" id="password" name="password" required placeholder="••••••••" minlength="4">
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label for="confirm_password" class="font-weight-bold">Confirmer le mot de passe</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                            </div>
                            <input type="password" class="form-control" id="confirm_password" name="confirm_password" required placeholder="••••••••" minlength="4">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-lg shadow-sm font-weight-bold">
                        <i class="fas fa-save mr-2"></i>Enregistrer le mot de passe
                    </button>
                </form>
                {% else %}
                    <div class="text-center py-3">
                        <a href="?page=login" class="btn btn-primary font-weight-bold">
                            <i class="fas fa-arrow-left mr-2"></i>Retour à la connexion
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
