{% extends 'base.html.twig' %}

{% block body %}
<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary text-white text-center py-4">
                <h4 class="m-0"><i class="fas fa-key mr-2"></i>Mot de passe oublié</h4>
                <small>Récupération de compte utilisateur</small>
            </div>
            <div class="card-body p-4">
                {% if error is defined and error %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle mr-2"></i>{{ error }}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                {% endif %}

                {% if success is defined and success %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle mr-2"></i>{{ success }}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                {% endif %}

                <form action="?page=forgotPassword&action=forgotPasswordSubmit" method="POST">
                    <div class="form-group mb-4">
                        <label for="email" class="font-weight-bold">Adresse E-mail</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            </div>
                            <input type="email" class="form-control" id="email" name="email" required placeholder="ex: user@mdm.com">
                        </div>
                        <small class="form-text text-muted mt-2">Saisissez votre email et nous vous enverrons un lien de réinitialisation.</small>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-lg shadow-sm font-weight-bold mb-3">
                        <i class="fas fa-paper-plane mr-2"></i>Envoyer le lien
                    </button>
                    <a href="?page=login" class="btn btn-outline-secondary btn-block font-weight-bold">
                        <i class="fas fa-arrow-left mr-2"></i>Retour à la connexion
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
