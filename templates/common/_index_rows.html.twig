{% set offset = offset|default(0) %}
{% for r in results %}
    <tr class="project-row">
        <td class="col-index text-muted font-weight-bold">{{ loop.index0 + offset + 1 }}</td>
        <td class="col-domain" data-value="{{ r.domain }}">{{ r.domain }}</td>
        <td class="col-sf" data-value="{{ r.sf }}">{{ r.sf }}</td>
        <td class="col-name">
            {% if r.webUrl is defined and r.webUrl != '' %}
                <a href="{{ r.webUrl }}"
                   class="url-link text-decoration-none"
                   target="_blank"
                   title="Voir le projet Gitlab{% if r.archived %} archivé{% endif %} {{ r.name }}">
                    <i class="fa-brands fa-gitlab text-warning"></i> {{ r.name }}
                </a>
            {% else %}
                {{ r.name }}
            {% endif %}
            <div class="project-tags mt-1 d-flex flex-wrap align-items-center" style="gap: 3px;">
                {% for tag in r.tags|default([]) %}
                    <span class="badge badge-light border text-secondary tag-badge" style="cursor: pointer; font-size: 0.72rem; padding: 2px 5px;" @click.stop="filterByTag('{{ tag|escape('js') }}')" title="Filtrer par ce tag">
                        <i class="fa-solid fa-tag mr-1 text-muted" style="font-size: 0.65rem;"></i>{{ tag }}
                        {% if session.user_role is defined and session.user_role == 'ROLE_ADMIN' %}
                            <i class="fa-solid fa-xmark ml-1 text-danger delete-tag-btn" style="cursor: pointer;" @click.stop="removeTag('{{ r.name|escape('js') }}', '{{ tag|escape('js') }}')" title="Supprimer ce tag"></i>
                        {% endif %}
                    </span>
                {% endfor %}
                {% if session.user_role is defined and session.user_role == 'ROLE_ADMIN' %}
                    <span class="badge badge-light border text-muted add-tag-btn" style="cursor: pointer; font-size: 0.72rem; padding: 2px 5px;" @click.stop="openTagInput('{{ r.name|escape('js') }}')" title="Ajouter un tag" x-show="editingProject !== '{{ r.name|escape('js') }}'">
                        <i class="fa-solid fa-plus"></i>
                    </span>
                    <span x-show="editingProject === '{{ r.name|escape('js') }}'" class="d-inline-flex align-items-center" style="display: none;" @click.stop="">
                        <input type="text" class="form-control form-control-sm px-1 py-0 tag-input" style="height: 20px; font-size: 0.75rem; width: 90px;" placeholder="Tag..." x-model="newTagText" @keyup.enter="saveTag('{{ r.name|escape('js') }}')" @keyup.escape="closeTagInput()" />
                        <button class="btn btn-xs btn-link text-success p-0 ml-1" type="button" @click.stop="saveTag('{{ r.name|escape('js') }}')" title="Valider"><i class="fa-solid fa-check"></i></button>
                        <button class="btn btn-xs btn-link text-muted p-0 ml-1" type="button" @click.stop="closeTagInput()" title="Annuler"><i class="fa-solid fa-xmark"></i></button>
                    </span>
                {% endif %}
            </div>
        </td>
        <td class="col-gcp" data-value="{% if r.cloudGCP == 1 %}oui{% else %}non{% endif %}">
            {% if r.cloudGCP == 1 %}<i class="fa-brands fa-google text-primary"></i>{% else %}-{% endif %}
        </td>

        <td class="col-sb">
            <span class="badge badge-info">
                {{ r.springBoot|default('N/A') }}
            </span>
        </td>

        <td class="col-java" data-value="{{ r.java|default('N/A') }}">
            <span class="badge badge-secondary">
                {{ r.java|default('N/A') }}
            </span>
        </td>

        <td class="col-mdm">
            <span class="badge badge-info">
                {{ r.mdmWorkloadVersion|default('N/A') }}
            </span>
        </td>

        <td class="col-status">
            {% set status = 'success' %}
            {% set label = 'OK' %}

            {% if r.java|default(0) < 17 %}
                {% set status = 'danger' %}
                {% set label = 'Java obsolète' %}
            {% elseif r.springBoot|default(0) < 3 %}
                {% set status = 'warning' %}
                {% set label = 'Spring Boot ancien' %}
            {% endif %}
            <span class="badge badge-{{ status }} status-label">
                {{ label }}
            </span>
        </td>
    </tr>
{% endfor %}
