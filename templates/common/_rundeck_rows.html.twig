{% set offset = offset|default(0) %}
{% for r in results %}
    {% set isEligibleForLogs = r.techno is defined and r.techno != '' and r.techno != 'php' %}
    <tr class="project-row" data-project-name="{{ r.name }}">
        <td class="col-index text-muted font-weight-bold">{{ loop.index0 + offset + 1 }}</td>
        <td class="col-domain" data-column="domain" data-value="{{ r.domain }}">{{ r.domain }}</td>
        <td class="col-sf" data-column="sf" data-value="{{ r.sf }}">{{ r.sf }}</td>
        <td class="col-name">
            {% set projectName = r.name|length > 35
                ? r.name|slice(0, 35) ~ '...'
                : r.name
            %}
            {% if r.webUrl is defined and r.webUrl != '' %}
                <a href="{{ r.webUrl }}"
                   class="url-link text-decoration-none"
                   target="_blank"
                   title="Voir le projet Gitlab{% if r.archived %} archivé{% endif %} {{ r.name }}">
                    <i class="fa-brands fa-gitlab text-warning"></i> {{ projectName }}
                </a>
            {% else %}
                {{ projectName }}
            {% endif %}
            <div class="project-tags mt-1 d-flex flex-wrap align-items-center" style="gap: 3px;" data-project="{{ r.name }}">
                {% for tag in r.tags|default([]) %}
                    <span class="badge badge-light border text-secondary tag-badge" style="cursor: pointer; font-size: 0.72rem; padding: 2px 5px;" onclick="filterByTag('{{ tag|escape('js') }}')" title="Filtrer par ce tag">
                        <i class="fa-solid fa-tag mr-1 text-muted" style="font-size: 0.65rem;"></i>{{ tag }}
                        {% if session.user_role is defined and session.user_role == 'ROLE_ADMIN' %}
                            <i class="fa-solid fa-xmark ml-1 text-danger delete-tag-btn" style="cursor: pointer;" onclick="event.stopPropagation(); removeTag('{{ r.name|escape('js') }}', '{{ tag|escape('js') }}')" title="Supprimer ce tag"></i>
                        {% endif %}
                    </span>
                {% endfor %}
                {% if session.user_role is defined and session.user_role == 'ROLE_ADMIN' %}
                    <span class="badge badge-light border text-muted add-tag-btn" style="cursor: pointer; font-size: 0.72rem; padding: 2px 5px;" onclick="openTagInput(this, '{{ r.name|escape('js') }}')" title="Ajouter un tag">
                        <i class="fa-solid fa-plus"></i>
                    </span>
                    <span class="tag-input-container d-none align-items-center" onclick="event.stopPropagation();">
                        <input type="text" class="form-control form-control-sm px-1 py-0 tag-input" style="height: 20px; font-size: 0.75rem; width: 90px;" placeholder="Tag..." onkeyup="if(event.key==='Enter'){saveTag(this, '{{ r.name|escape('js') }}');}else if(event.key==='Escape'){closeTagInput(this);}" />
                        <button class="btn btn-xs btn-link text-success p-0 ml-1" type="button" onclick="saveTag(this, '{{ r.name|escape('js') }}')" title="Valider"><i class="fa-solid fa-check"></i></button>
                        <button class="btn btn-xs btn-link text-muted p-0 ml-1" type="button" onclick="closeTagInput(this)" title="Annuler"><i class="fa-solid fa-xmark"></i></button>
                    </span>
                {% endif %}
            </div>
        </td>

        {% for env in ['dev', 'rec', 'pp', 'prod'] %}
        <td class="col-{{ env }} text-left" data-column="{{ env }}" data-env="{{ env }}">
            {% if r.urlsRundeck[env] is defined and r.urlsRundeck[env] != '' %}
            <a href="{{ r.urlsRundeck[env] }}" class="url-link ml-2" target="_blank" title="Voir le Rundeck de {{ env }}">
                <i class="fa-solid fa-code-branch text-danger"></i>
            </a>
            {% endif %}
        </td>
        {% endfor %}

        <td class="text-center">

        </td>
    </tr>
{% endfor %}
